{
  "title": {
    "en": "Set ready time"
  },
  "titleFormatted": {
    "en": "Ready at [[time]], [[ahead]] minutes ahead, on Mon [[mon]], Tue [[tue]], Wed [[wed]], Thu [[thu]], Fri [[fri]], Sat [[sat]], Sun [[sun]]"
  },
  "hint": {
    "en": "The Ready at time, how many minutes before it the water is ready, and the days of the week."
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=spa|water-heater"
    },
    {
      "type": "time",
      "name": "time",
      "title": {
        "en": "Time"
      }
    },
    {
      "type": "number",
      "name": "ahead",
      "title": {
        "en": "Minutes ahead"
      },
      "min": 0,
      "max": 30,
      "step": 5,
      "placeholder": {
        "en": "15"
      }
    },
    {
      "type": "checkbox",
      "name": "mon",
      "title": {
        "en": "Monday"
      },
      "value": false
    },
    {
      "type": "checkbox",
      "name": "tue",
      "title": {
        "en": "Tuesday"
      },
      "value": false
    },
    {
      "type": "checkbox",
      "name": "wed",
      "title": {
        "en": "Wednesday"
      },
      "value": false
    },
    {
      "type": "checkbox",
      "name": "thu",
      "title": {
        "en": "Thursday"
      },
      "value": false
    },
    {
      "type": "checkbox",
      "name": "fri",
      "title": {
        "en": "Friday"
      },
      "value": false
    },
    {
      "type": "checkbox",
      "name": "sat",
      "title": {
        "en": "Saturday"
      },
      "value": false
    },
    {
      "type": "checkbox",
      "name": "sun",
      "title": {
        "en": "Sunday"
      },
      "value": false
    }
  ]
}
