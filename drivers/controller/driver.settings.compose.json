    },
    "children": [
      {
        "id": "season_heat_below",
        "type": "number",
        "label": {
          "en": "Heating when outdoor mean below"
        },
        "value": 10,
        "min": -20,
        "max": 40,
        "step": 0.5,
        "units": {
          "en": "°C"
        },
        "hint": {
          "en": "Season Automatic: heating when the outdoor mean is below this. The outdoor mean is of the past 3 days, or with the forecast the past 2 days and the next 24 hours."
        }
      },
      {
        "id": "season_cool_outdoor_above",
        "type": "number",
        "label": {
          "en": "Cooling when outdoor mean above"
