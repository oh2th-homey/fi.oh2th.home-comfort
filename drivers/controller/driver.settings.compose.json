        "min": -20,
        "max": 40,
        "step": 0.5,
        "units": {
          "en": "°C"
        },
        "hint": {
          "en": "Season Automatic: cooling when the outdoor mean is above this and the indoor mean is above the next setting. Between the two outdoor limits the season stays as it is."
        }
      },
      {
        "id": "season_cool_indoor_above",
        "type": "number",
        "label": {
          "en": "and indoor mean above"
        },
        "value": 23,
        "min": -20,
        "max": 40,
        "step": 0.5,
        "units": {
          "en": "°C"
        },
        "hint": {
          "en": "The 24-hour mean of the zones that can cool. Without such zones Automatic never chooses cooling."
        }
      }
