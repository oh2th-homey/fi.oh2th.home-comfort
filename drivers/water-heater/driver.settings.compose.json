  {
    "type": "group",
    "label": {
      "en": "Prices"
    },
    "children": [
      {
        "id": "price_limit",
        "type": "number",
        "label": {
          "en": "Price limit"
        },
        "value": 0,
        "min": 0,
        "max": 10,
        "step": 0.01,
        "units": {
          "en": "/kWh"
        },
        "hint": {
          "en": "Skip a ready time when heating for it, or the ready time itself, would cost more per kWh. 0 = always heat. Keep is always held."
        }
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Heating block"
    },
    "children": [
      {
        "id": "block_from",
        "type": "text",
        "label": {
          "en": "Plan from"
        },
        "value": "",
        "hint": {
          "en": "HH:mm, empty for none. The night heat-up: the cheapest Longest block from this time to the next ready time, planned when its prices are known and told by Heating planned (for the heater's own schedule). Outside it only cheaper top-ups and Keep. Empty: the price plan alone."
        }
      },
      {
        "id": "block_max",
        "type": "number",
        "label": {
          "en": "Longest block"
        },
        "value": 180,
        "min": 30,
        "max": 360,
        "step": 15,
        "units": {
          "en": "min"
        },
        "hint": {
          "en": "The night block's length, e.g. the heater's own timer: enough to heat a cold tank. Heating that stops well before it is the thermostat: the tank is at its target temperature."
        }
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Heater"
    },
    "children": [
      {
        "id": "heater_power",
        "type": "number",
        "label": {
          "en": "Heater power"
        },
        "value": 2000,
        "min": 100,
        "max": 30000,
        "step": 100,
        "units": {
          "en": "W"
        },
        "hint": {
          "en": "Power while heating. With a power meter, the power while heating and the base load (such as a circulation pump) are learned."
        }
      }
    ]
  },
  {
    "type": "group",
    "label": {
      "en": "Learned heating curve"
    },
    "children": [
      {
        "id": "learned_state",
        "type": "label",
        "label": {
          "en": "State"
        },
        "value": "Learning",
        "hint": {
          "en": "Heats just in time until the curve is learned, then also ahead in cheap hours."
        }
      },
      {
        "id": "learned_heat_rate",
        "type": "label",
        "label": {
          "en": "Heating rate"
        },
        "value": "-"
      },
      {
        "id": "learned_loss",
        "type": "label",
        "label": {
          "en": "Heat loss"
        },
        "value": "-",
        "hint": {
          "en": "Share of the difference to the surroundings lost per hour."
        }
      },
      {
        "id": "learned_mix",
        "type": "label",
        "label": {
          "en": "Mixing drop"
        },
        "value": "-",
        "hint": {
          "en": "How much higher the water temperature reads while the water stands still, by how long it has stood. Planned with the reading minus this."
        }
      },
      {
        "id": "learned_power",
        "type": "label",
        "label": {
          "en": "Power"
        },
        "value": "-",
        "hint": {
          "en": "Learned from the power meter: heating, and the base load such as a circulation pump. Above halfway between them counts as heating."
        }
      },
      {
        "id": "learned_full",
        "type": "label",
        "label": {
          "en": "Target temperature"
        },
        "value": "-",
        "hint": {
          "en": "Learned with a power meter: where the tank's own thermostat stops the heater. Ready times and reheats heat to it."
        }
      }
    ]
  }
]
