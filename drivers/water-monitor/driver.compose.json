{
  "name": {
    "en": "Water Monitor"
  },
  "class": "sensor",
  "capabilities": ["meter_water.today", "meter_water.month"],
  "capabilitiesOptions": {
    "meter_water.today": {
      "title": {
        "en": "Water today"
      },
      "units": {
        "en": "l"
      },
      "decimals": 0
    },
    "meter_water.month": {
      "title": {
        "en": "Water this month"
      },
      "units": {
        "en": "m³"
      },
      "decimals": 2
    }
  },
  "$extends": ["device"],
  "pair": [
    {
      "id": "monitor"
    }
  ],
  "repair": [
    {
      "id": "monitor"
    }
  ]
}
